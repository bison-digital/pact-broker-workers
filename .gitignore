# Dependencies
node_modules/

# Build output
dist/
.wrangler/

# Environment files with secrets
.dev.vars
.envrc

# Materialised wrangler config — generated from wrangler.jsonc.tmpl by
# scripts/render-wrangler-config.mjs before dev, test and deploy.
wrangler.jsonc

# IDE / local agent config
.idea/
.vscode/
.claude/
.mcp.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Local Cloudflare state
.mf/

# Terraform. These also live in infra/.gitignore, but are repeated here
# deliberately: if infra/.gitignore is ever removed with the directory, the
# provider binaries it was hiding (~240 MB, over GitHub's 100 MB file limit)
# become untracked-but-not-ignored and the next `git add -A` commits them.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
