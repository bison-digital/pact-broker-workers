# Dependencies
node_modules/

# Build output
dist/
.wrangler/

# Environment files with secrets
.dev.vars
.envrc

# Materialised wrangler config — generated from wrangler.jsonc.tmpl by
# scripts/render-wrangler-config.mjs before dev, test and deploy.
wrangler.jsonc

# IDE / local agent config
.idea/
.vscode/
.claude/
.mcp.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Local Cloudflare state
.mf/

# Provider binaries, if anyone ever runs terraform in a checkout. This project
# has no IaC layer (removed in 2.0.0), but `terraform init` downloads a ~240 MB
# provider that exceeds GitHub's 100 MB file limit — and these patterns used to
# live in infra/.gitignore, which disappeared along with the directory.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
