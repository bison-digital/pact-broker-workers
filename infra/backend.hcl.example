# Terraform state backend for pact-broker-workers.
#
# Copy this file to `backend.hcl` (gitignored), fill in your values, then run
# from this directory:
#
#   terraform init -backend-config=backend.hcl
#
# The backend type in versions.tf is `s3`, meaning the S3 *protocol* — not
# Amazon S3. The reference backend for this project is a Cloudflare R2
# bucket, so running the broker needs nothing outside your Cloudflare
# account. Each operator maintains their own backend.hcl.

# ─── Cloudflare R2 (recommended) ─────────────────────────────────
#
# 1. Create an R2 bucket:  wrangler r2 bucket create your-org-terraform-state
# 2. Create an R2 API token with "Object Read & Write" scoped to that bucket
#    (R2 dashboard -> Manage R2 API Tokens). You get an Access Key ID and a
#    Secret Access Key.
# 3. Export them in the environment that runs Terraform. The S3 protocol
#    reads them from the conventional AWS_* names — that is a naming
#    convention of the protocol, not an AWS dependency:
#
#      export AWS_ACCESS_KEY_ID="<r2 access key id>"
#      export AWS_SECRET_ACCESS_KEY="<r2 secret access key>"

bucket = "your-org-terraform-state"
key    = "pact-broker-workers/terraform.tfstate"

# R2 presents a single region, reported as "auto".
region = "auto"

endpoints = {
  s3 = "https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"
}

# An S3-compatible endpoint is not Amazon, so the AWS-specific preflight
# checks have to be skipped or `terraform init` fails before it ever reaches
# the bucket.
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true

# State locking uses a lock object guarded by a conditional write
# (If-None-Match). R2 supports conditional writes on PutObject, so this
# should hold — but verify it against your own bucket before relying on it.
# If `terraform init` or the first `apply` errors on the lock, set this to
# false and serialise applies through the GitHub Environment gate instead.
use_lockfile = true

# ─── Amazon S3, MinIO, Backblaze B2, … ───────────────────────────
#
# Any S3-compatible store works. For real Amazon S3, drop the `endpoints`
# block and every skip_* flag, and set `region` to the bucket's region.
# Nothing in this project requires it — R2 is the path we document.
