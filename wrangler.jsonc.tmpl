/**
 * Wrangler config TEMPLATE — do not edit the materialised wrangler.jsonc.
 *
 * `wrangler.jsonc` is generated from this file by
 * scripts/render-wrangler-config.mjs, which runs automatically before dev,
 * test and deploy. Placeholders are filled from environment variables; see
 * that script for the full list and its local-dev defaults.
 *
 * If you need to change static settings (compatibility_flags, observability,
 * durable_objects bindings, migrations, etc.), edit THIS template —
 * `wrangler.jsonc` itself is gitignored and is overwritten on every render.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "${worker_name}",
  "account_id": "${account_id}",
  "main": "src/index.ts",
  "compatibility_date": "${compatibility_date}",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 9090
  },
  // Custom domain. Wrangler creates the DNS record and issues the
  // certificate on deploy — no separate DNS step and no IaC layer.
  //
  // Rendered as [] when DOMAIN is unset, which is the case for local dev and
  // the test suite. Never hand-write a domain here; it is per-environment.
  "routes": ${routes},
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PACT_BROKER",
        "class_name": "PactBrokerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PactBrokerDO"]
    }
  ],
  "vars": {
    "ALLOW_PUBLIC_READ": "${allow_public_read}",
    "CORS_ALLOWED_ORIGINS": "${cors_allowed_origins}",
    "PUBLIC_BADGES": "${public_badges}"
  },
  // Workers Rate Limiting API — runs inside the Worker isolate, no
  // zone-level Ruleset and no `Zone WAF: Edit` permission needed.
  // Available on every Cloudflare plan including Free. Per-binding
  // `namespace_id` is an account-scoped string identifying the counter
  // group; 1001 / 1002 are reserved for this broker.
  "ratelimits": [
    {
      "name": "MUTATING_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": ${mutating_rate_limit_threshold},
        "period": 60
      }
    },
    {
      "name": "READ_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": ${read_rate_limit_threshold},
        "period": 60
      }
    }
  ],
  // Declares the secret this Worker needs WITHOUT carrying its value.
  //
  // `wrangler deploy` fails if PACT_BROKER_TOKEN is not already set on the
  // Worker, so a broker that was never seeded cannot ship unauthenticated.
  // `wrangler dev` warns when it is missing from .dev.vars.
  //
  // Nothing in CI reads or writes the value. Seed it once, out of band:
  //
  //   openssl rand -hex 32 | wrangler secret put PACT_BROKER_TOKEN --name <worker>
  //
  // Worker secrets are durable across deploys — wrangler only removes one on
  // an explicit `wrangler secret delete`. Rotation is the same command again.
  //
  // Never add PACT_BROKER_TOKEN to `vars`: those are visible in the dashboard
  // and in `wrangler deploy` output.
  "secrets": {
    "required": ["PACT_BROKER_TOKEN"]
  }
}
