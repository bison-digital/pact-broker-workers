/**
 * Wrangler config TEMPLATE — do not edit the materialised wrangler.jsonc.
 *
 * `wrangler.jsonc` is generated from this file by
 * scripts/render-wrangler-config.mjs, which runs automatically before dev,
 * test and deploy. Placeholders are filled from environment variables; see
 * that script for the full list and its defaults.
 *
 * If you need to change static settings (compatibility_flags, observability,
 * durable_objects bindings, migrations, etc.), edit THIS template —
 * `wrangler.jsonc` itself is gitignored and gets overwritten on every render.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "${worker_name}",
  "account_id": "${account_id}",
  "main": "src/index.ts",
  "compatibility_date": "${compatibility_date}",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 9090
  },
  // Custom domain. Wrangler creates the DNS record and issues the certificate
  // on deploy — no DNS management and no separate IaC step.
  //
  // Rendered as [] when DOMAIN is unset, which is the case for local dev and
  // for the test suite. Do not hand-write a domain here; it is per-workspace.
  "routes": ${routes},
  // Per-IP rate limiting, enforced in src/index.ts.
  //
  // `period` must be 10 or 60 (Cloudflare constraint). Limits are per
  // Cloudflare location rather than zone-wide, and a throttled request still
  // costs a Worker invocation — see the middleware comment in src/index.ts for
  // why that trade is the right one for a CI-volume broker.
  //
  // namespace_id must be unique per limiter within your Cloudflare account.
  "ratelimits": [
    {
      "name": "RATE_LIMIT_MUTATING",
      "namespace_id": "1001",
      "simple": { "limit": ${mutating_rate_limit}, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_READ",
      "namespace_id": "1002",
      "simple": { "limit": ${read_rate_limit}, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PACT_BROKER",
        "class_name": "PactBrokerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PactBrokerDO"]
    }
  ],
  "vars": {
    "ALLOW_PUBLIC_READ": "${allow_public_read}",
    "CORS_ALLOWED_ORIGINS": "${cors_allowed_origins}",
    "PUBLIC_BADGES": "${public_badges}"
  },
  // Declares the secret this Worker needs WITHOUT carrying its value.
  //
  // `wrangler deploy` fails if PACT_BROKER_TOKEN is not already set on the
  // Worker, so a broker that was never seeded cannot ship unauthenticated.
  // `wrangler dev` warns if it is missing from .dev.vars.
  //
  // Nothing in CI reads or writes the value. Seed it once, out of band:
  //
  //   openssl rand -hex 32 | wrangler secret put PACT_BROKER_TOKEN --name <worker>
  //
  // Worker secrets are durable across deploys — wrangler only removes one on
  // an explicit `wrangler secret delete`. Rotation is the same command again.
  "secrets": {
    "required": ["PACT_BROKER_TOKEN"]
  }
  // Never add PACT_BROKER_TOKEN as a plaintext `vars` entry — `vars` are
  // visible in the dashboard and in `wrangler deploy` output.
}
