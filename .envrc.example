# Copy to `.envrc` (gitignored), fill in values, and `direnv allow`.
# Every TF_VAR_* below maps 1:1 to a terraform variable in infra/variables.tf.

# --- Cloudflare credentials ---
export TF_VAR_cloudflare_api_token=""
export TF_VAR_cloudflare_zone_id=""
export TF_VAR_cloudflare_account_id=""

# --- Terraform state backend (Cloudflare R2) ---
# Credentials for the R2 bucket holding Terraform state. Create the token in
# the R2 dashboard -> Manage R2 API Tokens, scoped to that bucket.
#
# The AWS_* names are the S3 protocol's convention, not an AWS dependency —
# Terraform's s3 backend reads credentials from them regardless of which
# S3-compatible store it is talking to. Bucket, endpoint and skip_* flags
# live in infra/backend.hcl (see infra/backend.hcl.example).
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""

# --- Per-workspace values ---
# Set these to the value for the workspace you're applying against. Rotate
# when you switch workspaces, or use direnv's `.envrc.<workspace>` layer.
export TF_VAR_domain=""                  # e.g. pact-broker-staging.your-domain.com
export TF_VAR_worker_name=""             # e.g. pact-broker-staging

# --- Optional ---
# export TF_VAR_allow_public_read="false"
# export TF_VAR_wrangler_compatibility_date="2026-04-15"

# --- NOT here: the broker's bearer token ---
# PACT_BROKER_TOKEN is not a Terraform variable and never passes through this
# file, Terraform, or CI. Seed it once per Worker, directly:
#
#   openssl rand -hex 32 | wrangler secret put PACT_BROKER_TOKEN --name <worker_name>
#
# Worker secrets survive every deploy, so rotation is the same command again.
